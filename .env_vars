# Source before running experiments:  source .env_vars
_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PROJECT_ROOT="${PROJECT_ROOT:-$_ENV_DIR}"
export OUT_DIR="${OUT_DIR:-$PROJECT_ROOT/results}"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

# GenMol assets (override if checkpoint/data live elsewhere)
export GENMOL_ROOT="${GENMOL_ROOT:-$PROJECT_ROOT/genmol}"
export GENMOL_MODEL_PATH="${GENMOL_MODEL_PATH:-$GENMOL_ROOT/model.ckpt}"
export GENMOL_ZINC250K_CSV="${GENMOL_ZINC250K_CSV:-$GENMOL_ROOT/data/zinc250k.csv}"
export GENMOL_HIT_VOCAB_DIR="${GENMOL_HIT_VOCAB_DIR:-$GENMOL_ROOT/scripts/exps/hit/vocab}"

# genetic_chemalactica ChemLlaMA (local dirs override HuggingFace ids in config)
# export HF_LOCAL_MODEL_DIR=/path/to/chemllama-checkpoint
# export HF_LOCAL_TOKENIZER_DIR=/path/to/chemllama-tokenizer
export CONDA_ENV_BIND_ORACLES="${CONDA_ENV_BIND_ORACLES:-bind_oracles}"

# Saturn Mamba prior (override if checkpoint lives elsewhere)
export SATURN_PRIOR_PATH="${SATURN_PRIOR_PATH:-$PROJECT_ROOT/saturn/experimental_reproduction/checkpoint_models/zinc-250k-mamba-epoch-50.prior}"

# Benchmark QuickVina HTTP service (scripts/start_benchmark_oracle.sh)
export ORACLE_HOST="${ORACLE_HOST:-127.0.0.1}"
export ORACLE_PORT="${ORACLE_PORT:-5050}"
export DOCKING_VINA_URL="${DOCKING_VINA_URL:-http://${ORACLE_HOST}:${ORACLE_PORT}}"

# Antitarget docking (7uyt, 5ut5, 7uyw, 4l00, 5khw): handled inside DockingOracle.predict() — one HTTP call per batch.
# export ANTITARGET_DOCK_REPEATS=3
# export ANTITARGET_DOCK_AGG=max

# Conda env names (see README.md)
export CONDA_ENV_CHEMALACTICA="${CONDA_ENV_CHEMALACTICA:-mol-grpo}"
export CONDA_ENV_GENMOL="${CONDA_ENV_GENMOL:-genmol}"
export CONDA_ENV_SATURN="${CONDA_ENV_SATURN:-saturn}"
export CONDA_ENV_GENETIC_GFN="${CONDA_ENV_GENETIC_GFN:-genetic_gfn}"
export ORACLE_CONDA_ENV="${ORACLE_CONDA_ENV:-mol-grpo}"
