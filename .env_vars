_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PROJECT_ROOT="${PROJECT_ROOT:-$_ENV_DIR}"
export OUT_DIR="${OUT_DIR:-$PROJECT_ROOT/results}"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

# Portable asset defaults (override paths in .env_vars_dev)
export GENMOL_ROOT="${GENMOL_ROOT:-$PROJECT_ROOT/genmol}"
export GENMOL_MODEL_PATH="${GENMOL_MODEL_PATH:-$GENMOL_ROOT/model.ckpt}"

# Docking: in-process by default. For parallel / hparam runs:
#   export DOCKING_USE_HTTP_SERVICE=1
#   ./benchmark/docking_oracle/start_oracle.sh
export ORACLE_HOST="${ORACLE_HOST:-127.0.0.1}"
export ORACLE_PORT="${ORACLE_PORT:-5050}"
export DOCKING_USE_HTTP_SERVICE="${DOCKING_USE_HTTP_SERVICE:-0}"
if [ "$DOCKING_USE_HTTP_SERVICE" = "1" ]; then
  export DOCKING_VINA_URL="${DOCKING_VINA_URL:-http://${ORACLE_HOST}:${ORACLE_PORT}}"
else
  unset DOCKING_VINA_URL
fi

# Conda env names (see README.md)
export CONDA_ENV_CHEMALACTICA="${CONDA_ENV_CHEMALACTICA:-mol-grpo}"
export CONDA_ENV_GENMOL="${CONDA_ENV_GENMOL:-genmol}"
export CONDA_ENV_SATURN="${CONDA_ENV_SATURN:-saturn}"
export CONDA_ENV_GENETIC_GFN="${CONDA_ENV_GENETIC_GFN:-genetic_gfn}"
export ORACLE_CONDA_ENV="${ORACLE_CONDA_ENV:-mol-grpo}"
